rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function restricted(d) {
      return d.get('status', 'active') in ['blocked', 'suspended'] &&
        (d.get('restrictedUntil', null) == null || d.restrictedUntil > request.time);
    }
    function adminKeys() {
      return ['status', 'restrictedUntil', 'restrictReason', 'restrictedAt', 'restrictedBy'];
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;   // admin Firebase Console se hi banayein
    }

    match /creators/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(adminKeys());
      allow update: if isAdmin() ||
                    (request.auth != null && request.auth.uid == uid
                     && !restricted(resource.data)
                     && !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminKeys()));
      allow delete: if isAdmin();

      match /projects/{pid} {
        allow read: if true;
        allow write: if isAdmin() ||
                     (request.auth != null && request.auth.uid == uid
                      && !restricted(get(/databases/$(database)/documents/creators/$(uid)).data));
      }
    }
  }
}
